# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Cloudinary (somente configurações PÚBLICAS no frontend) ──────────────────
# NUNCA coloque CLOUDINARY_API_SECRET aqui — ele fica nos Supabase Secrets
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key-public
# URL da Edge Function que faz a assinatura server-side
VITE_CLOUDINARY_SIGN_URL=/functions/v1/sign_cloudinary

# ─── PDF da Garantia (CDN público) ────────────────────────────────────────────
VITE_FENIX_GUIDE_PDF_URL=https://cdn.jsdelivr.net/gh/SEU_ORG/SEU_REPO@main/guia-de-garantia-fenix.pdf

# ─── Secrets que ficam APENAS no servidor (Supabase Secrets / GitHub Secrets) ─
# Não adicione estas variáveis ao .env do frontend:
#
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#   → configurado via: supabase secrets set CLOUDINARY_URL="cloudinary://..."
#
# WHATSAPP_API_TOKEN=seu_token_meta
# WHATSAPP_PHONE_NUMBER_ID=seu_numero_id
#   → configurados via Supabase Secrets para a Edge Function send-whatsapp
